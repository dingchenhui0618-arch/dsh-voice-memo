{
  "name": "dsh-voice-memo",
  "version": "0.1.0",
  "description": "Hold-to-talk voice memos for DeepSeek Harness: local timestamped transcription, a waveform PNG and a markdown note archived into your workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "workers/*.py"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "voice",
    "voice-memo",
    "transcription",
    "asr",
    "waveform",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingchenhui0618-arch/dsh-voice-memo.git"
  },
  "homepage": "https://github.com/dingchenhui0618-arch/dsh-voice-memo#readme",
  "bugs": {
    "url": "https://github.com/dingchenhui0618-arch/dsh-voice-memo/issues"
  },
  "license": "MIT"
}
